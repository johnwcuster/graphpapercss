{
  "name": "graphpapercss",
  "version": "0.3.0",
  "description": "A small, framework-agnostic CSS library for editorial spatial composition on a canonical 64-bit ruler.",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnwcuster/graphpapercss.git"
  },
  "style": "css/main.css",
  "exports": {
    ".": "./css/main.css",
    "./css/main.css": "./css/main.css",
    "./css/main.min.css": "./css/main.min.css",
    "./css/main.layer.css": "./css/main.layer.css",
    "./css/main.layer.min.css": "./css/main.layer.min.css",
    "./css/bands.css": "./css/bands.css",
    "./css/bands.min.css": "./css/bands.min.css",
    "./css/compat.css": "./css/compat.css",
    "./css/compat.min.css": "./css/compat.min.css",
    "./css/legacy/main.css": "./css/legacy/main.css",
    "./css/legacy/main.min.css": "./css/legacy/main.min.css"
  },
  "files": [
    "css/main*.css",
    "css/bands*.css",
    "css/compat*.css",
    "css/legacy/*.css",
    "docs/**",
    "src/manifest/grids.mjs",
    "src/manifest/layouts.mjs",
    "src/manifest/compact.mjs",
    "src/manifest/responsive.mjs",
    "src/manifest/bands.mjs",
    "src/ruler/geometry.mjs",
    "src/ruler/discovery.mjs",
    "src/ruler/bands.mjs",
    "src/ruler/accepted-changes.mjs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dist:build": "node scripts/build-distribution.mjs",
    "test:browsers": "node scripts/run-browsers.mjs",
    "test:distribution": "node scripts/run-browsers.mjs --distribution",
    "browsers:install": "playwright install chromium firefox webkit",
    "layouts:build": "node scripts/build-layouts.mjs",
    "size": "node scripts/size-report.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/build.mjs --check && node --test tests/*.test.mjs",
    "dev": "node scripts/serve.mjs",
    "docs:sync": "node scripts/sync-docs-assets.mjs",
    "docs:check": "node scripts/sync-docs-assets.mjs --check && node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "lightningcss": "1.33.0",
    "playwright": "1.64.0"
  }
}
