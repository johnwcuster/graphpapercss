{
  "name": "graphpapercss",
  "version": "0.5.0",
  "description": "A small, framework-agnostic CSS library for editorial spatial composition on a canonical 64-bit ruler.",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnwcuster/graphpapercss.git"
  },
  "style": "css/main.css",
  "exports": {
    ".": "./css/main.css",
    "./css/main.css": "./css/main.css",
    "./css/main.min.css": "./css/main.min.css",
    "./css/main.layer.css": "./css/main.layer.css",
    "./css/main.layer.min.css": "./css/main.layer.min.css",
    "./css/legacy/main.css": "./css/legacy/main.css",
    "./css/legacy/main.min.css": "./css/legacy/main.min.css",
    "./css/legacy/0.4/main.css": "./css/legacy/0.4/main.css",
    "./css/legacy/0.4/main.min.css": "./css/legacy/0.4/main.min.css",
    "./css/legacy/0.4/main.layer.css": "./css/legacy/0.4/main.layer.css",
    "./css/legacy/0.4/main.layer.min.css": "./css/legacy/0.4/main.layer.min.css",
    "./css/legacy/0.4/bands.css": "./css/legacy/0.4/bands.css",
    "./css/legacy/0.4/bands.min.css": "./css/legacy/0.4/bands.min.css",
    "./legacy/0.4/inspector": "./tools/inspector/index.js"
  },
  "files": [
    "css/main*.css",
    "css/legacy/**/*.css",
    "docs/**",
    "tools/inspector/**",
    "tools/shared/**",
    "src/legacy/0.4/manifest/grids.mjs",
    "src/legacy/0.4/manifest/layouts.mjs",
    "src/legacy/0.4/manifest/compact.mjs",
    "src/legacy/0.4/manifest/responsive.mjs",
    "src/legacy/0.4/manifest/bands.mjs",
    "src/legacy/0.4/ruler/geometry.mjs",
    "src/legacy/0.4/ruler/discovery.mjs",
    "src/legacy/0.4/ruler/bands.mjs",
    "src/legacy/0.4/ruler/accepted-changes.mjs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dist:build": "node scripts/build-core.mjs",
    "test:browsers": "node scripts/test-core-browsers.mjs",
    "test:distribution": "node scripts/test-distribution-browsers.mjs",
    "test:inspector": "node scripts/test-inspector-browsers.mjs",
    "test:inspector:package": "node scripts/test-inspector-package.mjs",
    "size:inspector": "node scripts/inspector-size.mjs",
    "browsers:install": "playwright install chromium firefox webkit",
    "size": "node scripts/size-report.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/build.mjs --check && node --test tests/*.test.mjs",
    "dev": "node scripts/serve.mjs",
    "docs:sync": "node scripts/sync-docs-assets.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/sync-docs-assets.mjs --check && node scripts/build-docs.mjs --check && node scripts/check-docs.mjs",
    "test:configurator": "node scripts/test-configurator-browsers.mjs",
    "legacy:test:browsers": "node scripts/run-browsers.mjs",
    "test:padding": "node scripts/test-padding-browsers.mjs",
    "test:vertical-spacing": "node scripts/build-vertical-spacing-fixture.mjs && node scripts/test-vertical-spacing-browsers.mjs",
    "test:package": "node scripts/test-distribution-package.mjs",
    "legacy:layouts:build": "node scripts/build-layouts.mjs",
    "test:docs": "node scripts/test-docs-browsers.mjs",
    "test:fallback": "node scripts/test-fallback-browsers.mjs",
    "test:release": "node scripts/test-release.mjs"
  },
  "devDependencies": {
    "lightningcss": "1.33.0",
    "marked": "18.1.1",
    "playwright": "1.64.0"
  }
}
